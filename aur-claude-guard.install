post_install() {
  cat <<'MSG'
==> aur-claude-guard installed.

Every makepkg run now reviews AUR build files with claude before it reads the
PKGBUILD. This covers yay, paru, and Pamac's Add/Remove Software alike.

  - Make sure the 'claude' CLI is installed and logged in for your user.
  - Bypass the review once with: AURGUARD=off yay -S <pkg>

Docs: /usr/share/doc/aur-claude-guard/README.md
MSG
}

post_upgrade() {
  # 2.0.0 replaced the yay shell hook with the makepkg gate.
  if (( $(vercmp "$2" 2.0.0) < 0 )); then
    cat <<'MSG'
==> aur-claude-guard now gates makepkg itself, so it also covers Pamac.
    The yay shell hook is gone: remove the line that sources
    /usr/share/aur-claude-guard/shell-hook.bash from ~/.bashrc.
MSG
  fi
}
