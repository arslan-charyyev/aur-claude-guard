[Unit]
Description=Periodic AUR update check (notifies via desktop notification)

[Timer]
# Shortly after login, then once a day. Persistent catches runs missed while the
# machine was off; the random delay avoids hitting the AUR RPC at the same instant
# as everyone else.
OnStartupSec=5min
OnCalendar=daily
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
